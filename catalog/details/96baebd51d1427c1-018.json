{"schemaVersion":"body.os.wger-details.v1","items":[{"id":"wger_c9e57bbee83944c6861d1c8dd2845e36","wgerId":458,"descriptionEn":"Get into a position on the floor supporting your weight on your forearms and toes. Arms are bent and directly below the shoulder. Keep your body straight at all times and hold this position as long as possible. To increase difficulty an arm or leg can be raised while performing this exercise.","descriptionZh":"起始姿势： 四肢着地。手臂弯曲成直角，肩部应该正好在肘部上方。背部挺直，整个身体在一条直线上。 步骤： 保持该姿势。","author":"YYCfit / BFad07","license":{"id":1,"short_name":"CC-BY-SA 3","full_name":" Creative Commons Attribution Share Alike 3","url":"https://creativecommons.org/licenses/by-sa/3.0/deed.en","author":"YYCfit / BFad07"},"translationLicenseEn":{"id":1,"short_name":"CC-BY-SA 3","full_name":" Creative Commons Attribution Share Alike 3","url":"https://creativecommons.org/licenses/by-sa/3.0/deed.en","author":"YYCfit / BFad07"},"translationLicenseZh":{"id":1,"short_name":"CC-BY-SA 3","full_name":" Creative Commons Attribution Share Alike 3","url":"https://creativecommons.org/licenses/by-sa/3.0/deed.en","author":"YYCfit / BFad07"},"sourceUrl":"https://wger.de/en/exercise/458","sourceUpdatedAt":"2026-10-10T17:06:12.972143+02:00","nameZhSource":"wger","nameZhModel":""},{"id":"wger_4f5de647eb73439484a7469d02a96de8","wgerId":1489,"descriptionEn":"Jumping jacks from the plank position.","descriptionZh":"","author":"jayninja","license":{"id":2,"short_name":"CC-BY-SA 4","full_name":"Creative Commons Attribution Share Alike 4","url":"https://creativecommons.org/licenses/by-sa/4.0/deed.en","author":"jayninja"},"translationLicenseEn":{"id":2,"short_name":"CC-BY-SA 4","full_name":"Creative Commons Attribution Share Alike 4","url":"https://creativecommons.org/licenses/by-sa/4.0/deed.en","author":"jayninja"},"translationLicenseZh":{},"sourceUrl":"https://wger.de/en/exercise/1489","sourceUpdatedAt":"2026-07-23T12:25:24.838818+02:00","nameZhSource":"search_translation","nameZhModel":"deepseek-flash"},{"id":"wger_124180676cb544db8973b5be25c0146b","wgerId":1766,"descriptionEn":"Position your body in plank position, keeping your eyes on the ground. Raise one arm in front of you and return it. Repeat with the other arm. Raise and return slowly while keeping your body as still as possible.","descriptionZh":"","author":"","license":{"id":2,"short_name":"CC-BY-SA 4","full_name":"Creative Commons Attribution Share Alike 4","url":"https://creativecommons.org/licenses/by-sa/4.0/deed.en","author":""},"translationLicenseEn":{"id":2,"short_name":"CC-BY-SA 4","full_name":"Creative Commons Attribution Share Alike 4","url":"https://creativecommons.org/licenses/by-sa/4.0/deed.en","author":""},"translationLicenseZh":{},"sourceUrl":"https://wger.de/en/exercise/1766","sourceUpdatedAt":"2026-07-23T12:25:15.572135+02:00","nameZhSource":"search_translation","nameZhModel":"deepseek-flash"},{"id":"wger_75d730d03b264a258f1a7119a98e02ef","wgerId":1091,"descriptionEn":"In the correct plank position, place your feet slightly wider than shoulder-width apart. alternately lift and touch the opposite shoulder with one hand.","descriptionZh":"","author":"clafal","license":{"id":2,"short_name":"CC-BY-SA 4","full_name":"Creative Commons Attribution Share Alike 4","url":"https://creativecommons.org/licenses/by-sa/4.0/deed.en","author":"clafal"},"translationLicenseEn":{"id":2,"short_name":"CC-BY-SA 4","full_name":"Creative Commons Attribution Share Alike 4","url":"https://creativecommons.org/licenses/by-sa/4.0/deed.en","author":"clafal"},"translationLicenseZh":{},"sourceUrl":"https://wger.de/en/exercise/1091","sourceUpdatedAt":"2026-06-19T18:49:27.457604+02:00","nameZhSource":"search_translation","nameZhModel":"deepseek-flash"},{"id":"wger_94f2dea6b33641b2a4383ab7b13adbf7","wgerId":1410,"descriptionEn":"In a plank position, lift one leg alternately.","descriptionZh":"","author":"hpmbala@gmail.com","license":{"id":2,"short_name":"CC-BY-SA 4","full_name":"Creative Commons Attribution Share Alike 4","url":"https://creativecommons.org/licenses/by-sa/4.0/deed.en","author":"hpmbala@gmail.com"},"translationLicenseEn":{"id":2,"short_name":"CC-BY-SA 4","full_name":"Creative Commons Attribution Share Alike 4","url":"https://creativecommons.org/licenses/by-sa/4.0/deed.en","author":"hpmbala@gmail.com"},"translationLicenseZh":{},"sourceUrl":"https://wger.de/en/exercise/1410","sourceUpdatedAt":"2026-04-15T22:23:55.022458+02:00","nameZhSource":"search_translation","nameZhModel":"deepseek-flash"},{"id":"wger_e75629ed49914a48984cb297f3f9fb58","wgerId":1406,"descriptionEn":"The Plank-to-Elbow Extension is a dynamic exercise that combines the plank with an elbow extension movement","descriptionZh":"","author":"clafal","license":{"id":2,"short_name":"CC-BY-SA 4","full_name":"Creative Commons Attribution Share Alike 4","url":"https://creativecommons.org/licenses/by-sa/4.0/deed.en","author":"clafal"},"translationLicenseEn":{"id":2,"short_name":"CC-BY-SA 4","full_name":"Creative Commons Attribution Share Alike 4","url":"https://creativecommons.org/licenses/by-sa/4.0/deed.en","author":"clafal"},"translationLicenseZh":{},"sourceUrl":"https://wger.de/en/exercise/1406","sourceUpdatedAt":"2026-07-23T12:25:24.430447+02:00","nameZhSource":"search_translation","nameZhModel":"deepseek-flash"},{"id":"wger_f397656d6f2647c69e4c221687f3f2fa","wgerId":1275,"descriptionEn":"This stretch is for the ankles, as well as Tibialis anterior.","descriptionZh":"","author":"erikocobra","license":{"id":2,"short_name":"CC-BY-SA 4","full_name":"Creative Commons Attribution Share Alike 4","url":"https://creativecommons.org/licenses/by-sa/4.0/deed.en","author":"erikocobra"},"translationLicenseEn":{"id":2,"short_name":"CC-BY-SA 4","full_name":"Creative Commons Attribution Share Alike 4","url":"https://creativecommons.org/licenses/by-sa/4.0/deed.en","author":"erikocobra"},"translationLicenseZh":{},"sourceUrl":"https://wger.de/en/exercise/1275","sourceUpdatedAt":"2026-07-23T12:08:38.077009+02:00","nameZhSource":"search_translation","nameZhModel":"deepseek-flash"},{"id":"wger_493fb1acc45a4b18bcbb58b809881e6f","wgerId":1430,"descriptionEn":"The plate pinch hold is a grip strength exercise designed to target the forearms and improve grip endurance. Select one or two weight plates (smooth-edged plates work best) and pinch them together between your thumb and fingers. Hold the plates with your arm straight down by your side or extended slightly in front of you. Maintain the hold for as long as you can, keeping your shoulders relaxed and your grip firm. This exercise can be done for time or repetitions.","descriptionZh":"","author":"hpmbala@gmail.com","license":{"id":2,"short_name":"CC-BY-SA 4","full_name":"Creative Commons Attribution Share Alike 4","url":"https://creativecommons.org/licenses/by-sa/4.0/deed.en","author":"hpmbala@gmail.com"},"translationLicenseEn":{"id":2,"short_name":"CC-BY-SA 4","full_name":"Creative Commons Attribution Share Alike 4","url":"https://creativecommons.org/licenses/by-sa/4.0/deed.en","author":"hpmbala@gmail.com"},"translationLicenseZh":{},"sourceUrl":"https://wger.de/en/exercise/1430","sourceUpdatedAt":"2026-06-19T18:52:35.812847+02:00","nameZhSource":"search_translation","nameZhModel":"deepseek-flash"},{"id":"wger_5d5122e065f34afcac3621955e2c7dde","wgerId":2623,"descriptionEn":"Sit at a plate-loaded (lever) lat pulldown machine with your thighs secured under the pads. Grip the handles overhead with arms fully extended. Pull the handles down toward your upper chest by driving your elbows down and back, squeezing your lats at the bottom. Return slowly to full extension. Resistance comes from weight plates loaded on the machine's lever arms rather than a cable stack.","descriptionZh":"","author":"trs1800","license":{"id":2,"short_name":"CC-BY-SA 4","full_name":"Creative Commons Attribution Share Alike 4","url":"https://creativecommons.org/licenses/by-sa/4.0/deed.en","author":"trs1800"},"translationLicenseEn":{"id":2,"short_name":"CC-BY-SA 4","full_name":"Creative Commons Attribution Share Alike 4","url":"https://creativecommons.org/licenses/by-sa/4.0/deed.en","author":"trs1800"},"translationLicenseZh":{},"sourceUrl":"https://wger.de/en/exercise/2623","sourceUpdatedAt":"2026-09-14T23:25:37.108370+02:00","nameZhSource":"search_translation","nameZhModel":"deepseek-flash"},{"id":"wger_0e8fd83f4e974749b5fdda9d0e85e97a","wgerId":2488,"descriptionEn":"Lie on your back with knees bent, feet flat on the floor. Flatten your lower back against the floor by tilting your pelvis posteriorly, engaging your abs and glutes. Hold 5 seconds, release. This retrains pelvic positioning to counter anterior pelvic tilt.","descriptionZh":"","author":"Raj","license":{"id":2,"short_name":"CC-BY-SA 4","full_name":"Creative Commons Attribution Share Alike 4","url":"https://creativecommons.org/licenses/by-sa/4.0/deed.en","author":"Raj"},"translationLicenseEn":{"id":2,"short_name":"CC-BY-SA 4","full_name":"Creative Commons Attribution Share Alike 4","url":"https://creativecommons.org/licenses/by-sa/4.0/deed.en","author":"Raj"},"translationLicenseZh":{},"sourceUrl":"https://wger.de/en/exercise/2488","sourceUpdatedAt":"2026-08-04T18:42:40.515603+02:00","nameZhSource":"search_translation","nameZhModel":"deepseek-flash"},{"id":"wger_52dec48d25a44a78b66bad6a773e143a","wgerId":683,"descriptionEn":"Olympic weight lifting","descriptionZh":"","author":"wger.de","license":{"id":1,"short_name":"CC-BY-SA 3","full_name":" Creative Commons Attribution Share Alike 3","url":"https://creativecommons.org/licenses/by-sa/3.0/deed.en","author":"wger.de"},"translationLicenseEn":{"id":1,"short_name":"CC-BY-SA 3","full_name":" Creative Commons Attribution Share Alike 3","url":"https://creativecommons.org/licenses/by-sa/3.0/deed.en","author":"wger.de"},"translationLicenseZh":{},"sourceUrl":"https://wger.de/en/exercise/683","sourceUpdatedAt":"2026-04-15T22:23:56.195471+02:00","nameZhSource":"search_translation","nameZhModel":"deepseek-flash"},{"id":"wger_7cd765658a8f465898f1253af9d8bb39","wgerId":1658,"descriptionEn":"Single arm curl that can be done using a dumbbell and a preacher bench, or a preacher curl machine. Turn body away from the weight","descriptionZh":"","author":"Shiladree","license":{"id":2,"short_name":"CC-BY-SA 4","full_name":"Creative Commons Attribution Share Alike 4","url":"https://creativecommons.org/licenses/by-sa/4.0/deed.en","author":"Shiladree"},"translationLicenseEn":{"id":2,"short_name":"CC-BY-SA 4","full_name":"Creative Commons Attribution Share Alike 4","url":"https://creativecommons.org/licenses/by-sa/4.0/deed.en","author":"Shiladree"},"translationLicenseZh":{},"sourceUrl":"https://wger.de/en/exercise/1658","sourceUpdatedAt":"2026-06-19T19:52:26.062795+03:00","nameZhSource":"search_translation","nameZhModel":"deepseek-flash"},{"id":"wger_4baa496264bd434fb2ed0c3c88099841","wgerId":1657,"descriptionEn":"Single arm curl that can be done using a dumbbell and a preacher bench, or a preacher curl machine. Turn body towards the weight","descriptionZh":"","author":"Shiladree","license":{"id":2,"short_name":"CC-BY-SA 4","full_name":"Creative Commons Attribution Share Alike 4","url":"https://creativecommons.org/licenses/by-sa/4.0/deed.en","author":"Shiladree"},"translationLicenseEn":{"id":2,"short_name":"CC-BY-SA 4","full_name":"Creative Commons Attribution Share Alike 4","url":"https://creativecommons.org/licenses/by-sa/4.0/deed.en","author":"Shiladree"},"translationLicenseZh":{},"sourceUrl":"https://wger.de/en/exercise/1657","sourceUpdatedAt":"2026-06-19T18:51:26.337084+02:00","nameZhSource":"search_translation","nameZhModel":"deepseek-flash"},{"id":"wger_d5fb660648324216bc0a36955b5f741f","wgerId":2539,"descriptionEn":"An isometric preacher curl is a static strength exercise where you hold a fixed position on a preacher pad or and inclined bench under tension without moving the joint.","descriptionZh":"","author":"HexoctusEngineering","license":{"id":2,"short_name":"CC-BY-SA 4","full_name":"Creative Commons Attribution Share Alike 4","url":"https://creativecommons.org/licenses/by-sa/4.0/deed.en","author":"HexoctusEngineering"},"translationLicenseEn":{"id":2,"short_name":"CC-BY-SA 4","full_name":"Creative Commons Attribution Share Alike 4","url":"https://creativecommons.org/licenses/by-sa/4.0/deed.en","author":"HexoctusEngineering"},"translationLicenseZh":{},"sourceUrl":"https://wger.de/en/exercise/2539","sourceUpdatedAt":"2026-09-11T22:43:28.285378+02:00","nameZhSource":"search_translation","nameZhModel":"deepseek-flash"},{"id":"wger_7eb529390e334319829dd8e142fc74d9","wgerId":2633,"descriptionEn":"Custom description created by the Integrated Conditioning routine importer for wger.","descriptionZh":"","author":"","license":{"id":2,"short_name":"CC-BY-SA 4","full_name":"Creative Commons Attribution Share Alike 4","url":"https://creativecommons.org/licenses/by-sa/4.0/deed.en","author":""},"translationLicenseEn":{"id":2,"short_name":"CC-BY-SA 4","full_name":"Creative Commons Attribution Share Alike 4","url":"https://creativecommons.org/licenses/by-sa/4.0/deed.en","author":""},"translationLicenseZh":{},"sourceUrl":"https://wger.de/en/exercise/2633","sourceUpdatedAt":"2026-09-16T02:47:51.467713+03:00","nameZhSource":"search_translation","nameZhModel":"deepseek-flash"},{"id":"wger_dd52fb9994264a78b44620a8e3e4ec47","wgerId":465,"descriptionEn":"Place the EZ curl bar on the rest handles in front of the preacher bench. Lean over the bench and grab the EZ curl bar with palms up. Sit down on the preacher bench seat so your upper arms rest on top of the pad and your chest is pressed against the pad. Lower the weight until your elbows are extended and arms are straight. Bring the weights back up to the starting point by contracting biceps. Repeat","descriptionZh":"","author":"cgoob883","license":{"id":1,"short_name":"CC-BY-SA 3","full_name":" Creative Commons Attribution Share Alike 3","url":"https://creativecommons.org/licenses/by-sa/3.0/deed.en","author":"cgoob883"},"translationLicenseEn":{"id":1,"short_name":"CC-BY-SA 3","full_name":" Creative Commons Attribution Share Alike 3","url":"https://creativecommons.org/licenses/by-sa/3.0/deed.en","author":"cgoob883"},"translationLicenseZh":{},"sourceUrl":"https://wger.de/en/exercise/465","sourceUpdatedAt":"2026-07-23T12:08:30.792885+02:00","nameZhSource":"search_translation","nameZhModel":"deepseek-flash"},{"id":"wger_f9866335e489404b84b5248fb8512702","wgerId":1208,"descriptionEn":"Stand upright with your chest slightly raised, your feet hip-width apart and your toes pointing straight ahead. Bring your hands to the back of your head with your fingers slightly interlaced and your elbows pointing to the side. Push your hips back and bend your knees, keeping your upper body as upright as possible. Push your knees outwards, they must never point towards each other. If your upper body moves slightly forward, make sure that it does not bend. Always keep your elbows level with your ears by tensing the muscles between your shoulder blades. If you are flexible enough, you can sink down until your buttocks touch your calves. However, make sure that you do not bend your spine. Before this happens, reverse the movement and use your heels and glutes to push yourself upwards with so much momentum that your feet lift off briefly and you do a little hop. If necessary, correct the position of your feet, arms and upper body before you move on to the next repetition. Translated with www.DeepL.com/Translator (free version)","descriptionZh":"","author":"lxmx","license":{"id":2,"short_name":"CC-BY-SA 4","full_name":"Creative Commons Attribution Share Alike 4","url":"https://creativecommons.org/licenses/by-sa/4.0/deed.en","author":"lxmx"},"translationLicenseEn":{"id":2,"short_name":"CC-BY-SA 4","full_name":"Creative Commons Attribution Share Alike 4","url":"https://creativecommons.org/licenses/by-sa/4.0/deed.en","author":"lxmx"},"translationLicenseZh":{},"sourceUrl":"https://wger.de/en/exercise/1208","sourceUpdatedAt":"2026-07-23T12:25:11.133459+02:00","nameZhSource":"search_translation","nameZhModel":"deepseek-flash"},{"id":"wger_9cb69afc7a444a22b9a97bde8aca5b11","wgerId":468,"descriptionEn":"Lying on stomach with head on towel. Stretch arms straight out to your sides. Slowly lift your arms, pulling your shoulderblades together, hold for 3 seconds.","descriptionZh":"","author":"donaddon","license":{"id":2,"short_name":"CC-BY-SA 4","full_name":"Creative Commons Attribution Share Alike 4","url":"https://creativecommons.org/licenses/by-sa/4.0/deed.en","author":"donaddon"},"translationLicenseEn":{"id":2,"short_name":"CC-BY-SA 4","full_name":"Creative Commons Attribution Share Alike 4","url":"https://creativecommons.org/licenses/by-sa/4.0/deed.en","author":"donaddon"},"translationLicenseZh":{},"sourceUrl":"https://wger.de/en/exercise/468","sourceUpdatedAt":"2026-06-19T18:49:00.937444+02:00","nameZhSource":"search_translation","nameZhModel":"deepseek-flash"},{"id":"wger_c38b0f697f014f0f82cce33cdc658f9e","wgerId":1284,"descriptionEn":"You should have the shoulder line in front of your wrists an perform a push-up, maintaining the shoulder in the same position","descriptionZh":"","author":"vdrb","license":{"id":2,"short_name":"CC-BY-SA 4","full_name":"Creative Commons Attribution Share Alike 4","url":"https://creativecommons.org/licenses/by-sa/4.0/deed.en","author":"vdrb"},"translationLicenseEn":{"id":2,"short_name":"CC-BY-SA 4","full_name":"Creative Commons Attribution Share Alike 4","url":"https://creativecommons.org/licenses/by-sa/4.0/deed.en","author":"vdrb"},"translationLicenseZh":{},"sourceUrl":"https://wger.de/en/exercise/1284","sourceUpdatedAt":"2026-06-19T18:51:16.047534+02:00","nameZhSource":"search_translation","nameZhModel":"deepseek-flash"},{"id":"wger_7f834f07fa7b46b68ffa45930b0602db","wgerId":477,"descriptionEn":"","descriptionZh":"","author":"wger.de","license":{"id":1,"short_name":"CC-BY-SA 3","full_name":" Creative Commons Attribution Share Alike 3","url":"https://creativecommons.org/licenses/by-sa/3.0/deed.en","author":"wger.de"},"translationLicenseEn":{"id":1,"short_name":"CC-BY-SA 3","full_name":" Creative Commons Attribution Share Alike 3","url":"https://creativecommons.org/licenses/by-sa/3.0/deed.en","author":"wger.de"},"translationLicenseZh":{},"sourceUrl":"https://wger.de/en/exercise/477","sourceUpdatedAt":"2026-04-15T22:23:55.167004+02:00","nameZhSource":"search_translation","nameZhModel":"deepseek-flash"},{"id":"wger_5e3a322b98dd4197b16f4ac72c42c223","wgerId":1537,"descriptionEn":"Hold the pull-up movement in any position","descriptionZh":"","author":"DiscoCop","license":{"id":2,"short_name":"CC-BY-SA 4","full_name":"Creative Commons Attribution Share Alike 4","url":"https://creativecommons.org/licenses/by-sa/4.0/deed.en","author":"DiscoCop"},"translationLicenseEn":{"id":2,"short_name":"CC-BY-SA 4","full_name":"Creative Commons Attribution Share Alike 4","url":"https://creativecommons.org/licenses/by-sa/4.0/deed.en","author":"DiscoCop"},"translationLicenseZh":{},"sourceUrl":"https://wger.de/en/exercise/1537","sourceUpdatedAt":"2026-04-15T22:23:55.189031+02:00","nameZhSource":"search_translation","nameZhModel":"deepseek-flash"},{"id":"wger_8e42040806824ab689f52681e54c7ce0","wgerId":475,"descriptionEn":"Grab the pull up bar with a wide grip, the body is hanging freely. Keep your chest out and pull yourself up till your chin reaches the bar or it touches your neck, if you want to pull behind you. Go with a slow and controlled movement down, always keeping the chest out.","descriptionZh":"起始姿势：先悬挂在单杠上，手掌朝前，双脚离地。双手比肩稍宽。不要太宽，肘部不要在身体两边，要在身体前面。身体应为伸直，略微向前的状态。手臂应处于伸展状态。 步骤： 用力均匀地拉起你的身体，使胸部靠近单杠，下巴刚好超过横杆。不要跃起或晃起身体，比如踢腿。 小心地把身体放下来，回到起始位置。 重复进行。 提示：——引体向上要想做得正确，您必须先增强几个关键部位的力量，包括肩膀、手臂和腹肌。您应该通过其他练习积累了足够的力量后，再开始做引体向上。","author":"wger.de","license":{"id":1,"short_name":"CC-BY-SA 3","full_name":" Creative Commons Attribution Share Alike 3","url":"https://creativecommons.org/licenses/by-sa/3.0/deed.en","author":"wger.de"},"translationLicenseEn":{"id":1,"short_name":"CC-BY-SA 3","full_name":" Creative Commons Attribution Share Alike 3","url":"https://creativecommons.org/licenses/by-sa/3.0/deed.en","author":"wger.de"},"translationLicenseZh":{"id":1,"short_name":"CC-BY-SA 3","full_name":" Creative Commons Attribution Share Alike 3","url":"https://creativecommons.org/licenses/by-sa/3.0/deed.en","author":"wger.de"},"sourceUrl":"https://wger.de/en/exercise/475","sourceUpdatedAt":"2026-04-15T22:23:56.751242+02:00","nameZhSource":"wger","nameZhModel":""},{"id":"wger_1f490456b4264b89b70ce155c3571422","wgerId":1696,"descriptionEn":"Execution Pulling phase (concentric): Drive your elbows down and back , pulling your chest toward your hands . Keep your shoulders depressed and retracted (avoid shrugging). Focus on squeezing your lats and upper back at the top. Top position: Chin should clear or reach the level of your hands. Pause briefly and contract your lats hard.","descriptionZh":"","author":"daiben","license":{"id":2,"short_name":"CC-BY-SA 4","full_name":"Creative Commons Attribution Share Alike 4","url":"https://creativecommons.org/licenses/by-sa/4.0/deed.en","author":"daiben"},"translationLicenseEn":{"id":2,"short_name":"CC-BY-SA 4","full_name":"Creative Commons Attribution Share Alike 4","url":"https://creativecommons.org/licenses/by-sa/4.0/deed.en","author":"daiben"},"translationLicenseZh":{},"sourceUrl":"https://wger.de/en/exercise/1696","sourceUpdatedAt":"2026-06-19T18:54:32.427383+02:00","nameZhSource":"search_translation","nameZhModel":"deepseek-flash"},{"id":"wger_be4eb0b62c394ff5b57d419f1687c90f","wgerId":1695,"descriptionEn":"Execution Pulling phase (concentric): Drive your elbows down and slightly back , pulling your chest toward the bar . Focus on leading with your chest , not your chin. Keep your shoulders depressed (avoid shrugging). Top position: Chin should clear the bar (or at least reach bar level). Pause for a brief squeeze in your lats .","descriptionZh":"","author":"daiben","license":{"id":2,"short_name":"CC-BY-SA 4","full_name":"Creative Commons Attribution Share Alike 4","url":"https://creativecommons.org/licenses/by-sa/4.0/deed.en","author":"daiben"},"translationLicenseEn":{"id":2,"short_name":"CC-BY-SA 4","full_name":"Creative Commons Attribution Share Alike 4","url":"https://creativecommons.org/licenses/by-sa/4.0/deed.en","author":"daiben"},"translationLicenseZh":{},"sourceUrl":"https://wger.de/en/exercise/1695","sourceUpdatedAt":"2026-06-19T18:53:54.413810+02:00","nameZhSource":"search_translation","nameZhModel":"deepseek-flash"},{"id":"wger_289bd40be3dd42178670e475771a0ea7","wgerId":1905,"descriptionEn":"Set weight and grip for the cables in the cage. Take a few steps away, bend over, pull and extend the back at the same time.","descriptionZh":"","author":"cybro","license":{"id":2,"short_name":"CC-BY-SA 4","full_name":"Creative Commons Attribution Share Alike 4","url":"https://creativecommons.org/licenses/by-sa/4.0/deed.en","author":"cybro"},"translationLicenseEn":{"id":2,"short_name":"CC-BY-SA 4","full_name":"Creative Commons Attribution Share Alike 4","url":"https://creativecommons.org/licenses/by-sa/4.0/deed.en","author":"cybro"},"translationLicenseZh":{},"sourceUrl":"https://wger.de/en/exercise/1905","sourceUpdatedAt":"2026-07-23T12:36:51.251808+02:00","nameZhSource":"search_translation","nameZhModel":"deepseek-flash"},{"id":"wger_9ccd53e083924e6191aae4e5f4ea339c","wgerId":1273,"descriptionEn":"Doubling as a back and chest exercise, the Dumbbell Pullover can train both your pecs and lats.","descriptionZh":"","author":"3leh","license":{"id":2,"short_name":"CC-BY-SA 4","full_name":"Creative Commons Attribution Share Alike 4","url":"https://creativecommons.org/licenses/by-sa/4.0/deed.en","author":"3leh"},"translationLicenseEn":{"id":2,"short_name":"CC-BY-SA 4","full_name":"Creative Commons Attribution Share Alike 4","url":"https://creativecommons.org/licenses/by-sa/4.0/deed.en","author":"3leh"},"translationLicenseZh":{},"sourceUrl":"http